                return {
                    "intent": "kg.path",
                    "entity": src,
                    "args": {
                        "source": src,
                        "target": tgt,
                        "mode": "developer",
                    },
                }

        if clean.startswith("kg path "):
            if len(smart_tokens) >= 4:
                src = smart_tokens[2]
                tgt = smart_tokens[-1]
                if self._is_reserved(src) or self._is_reserved(tgt):
