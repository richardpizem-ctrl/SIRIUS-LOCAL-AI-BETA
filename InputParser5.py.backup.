                        "mode": "developer",
                    },
                }

        # ====================================================
        # ⭐⭐⭐ KG ATTRIBUTES ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.attributes "):
            if len(smart_tokens) >= 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.attributes",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
                }

        if clean.startswith("kg attributes "):
            if len(smart_tokens) >= 3:
                entity = smart_tokens[2]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.attributes",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
                }

        # ====================================================
        # ⭐⭐⭐ KG ADD ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.add "):
            if len(smart_tokens) >= 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.add",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
                }

        if clean.startswith("kg add "):
            if len(smart_tokens) >= 3:
                entity = smart_tokens[2]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.add",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
                }

        # ====================================================
        # ⭐⭐⭐ KG REMOVE ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.remove "):
            if len(smart_tokens) >= 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.remove",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
                }

        if clean.startswith("kg remove "):
            if len(smart_tokens) >= 3:
                entity = smart_tokens[2]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.remove",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
                }

        # ====================================================
        # ⭐⭐⭐ KG DELETE ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.delete "):
            if len(smart_tokens) == 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.delete",
