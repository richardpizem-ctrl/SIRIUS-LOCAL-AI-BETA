                    "args": {"entity": entity, "mode": "developer"},
                }

        # ====================================================
        # ⭐⭐⭐ KG INFER ⭐⭐⭐
        # ====================================================
        if clean == "kg.infer" or clean.startswith("kg infer") or clean == "infer":
            return {
                "intent": "kg.infer",
                "entity": None,
                "args": {"mode": "developer"},
            }

        # ====================================================
        # ⭐⭐⭐ REASON WHY ⭐⭐⭐
        # ====================================================
