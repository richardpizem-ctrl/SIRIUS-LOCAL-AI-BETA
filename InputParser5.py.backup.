        # ⭐⭐⭐ KG LIST ⭐⭐⭐
        # ====================================================
        if clean in ("kg_list", "kg.list", "kg list", "kglist") or raw_input.strip().upper() == "KG_LIST":
            return {
                "intent": "kg.list",
                "entity": None,
                "args": {
                    "mode": "developer",
                },
            }

        if clean.startswith("kg list entities"):
            return {
                "intent": "kg.list",
                "entity": None,
                "args": {
                    "mode": "developer",
                },
            }

        # ====================================================
        # ⭐⭐⭐ KG SEARCH ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg search "):
            if len(smart_tokens) >= 3:
                entity = smart_tokens[2]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.search",
                    "entity": entity,
                    "args": {
                        "entity": entity,
                        "query": entity,
                        "mode": "developer",
                    },
                }

        if clean.startswith("kg.search "):
            if len(smart_tokens) >= 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.search",
                    "entity": entity,
                    "args": {
                        "entity": entity,
                        "query": entity,
                        "mode": "developer",
                    },
                }

        # ====================================================
        # ⭐⭐⭐ KG RENAME ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg rename "):
            if len(smart_tokens) >= 4:
                old_name = smart_tokens[2]
                new_name = smart_tokens[3]
                if self._is_reserved(old_name):
                    return result
                return {
                    "intent": "kg.rename",
                    "entity": old_name,
                    "args": {
                        "old": old_name,
                        "new": new_name,
                        "mode": "developer",
                    },
                }

            if len(smart_tokens) >= 3:
                old_name = smart_tokens[2]
                new_name = smart_tokens[3] if len(smart_tokens) > 3 else ""
                if self._is_reserved(old_name):
                    return result
                return {
                    "intent": "kg.rename",
                    "entity": old_name,
                    "args": {
                        "old": old_name,
                        "new": new_name,
                        "mode": "developer",
                    },
                }

        if clean.startswith("kg.rename "):
            if len(smart_tokens) >= 3:
                old_name = smart_tokens[1]
                new_name = smart_tokens[2]
                if self._is_reserved(old_name):
                    return result
                return {
                    "intent": "kg.rename",
                    "entity": old_name,
                    "args": {
                        "old": old_name,
                        "new": new_name,
                        "mode": "developer",
                    },
                }

        # ====================================================
        # ⭐⭐⭐ KG EXISTS ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg exists "):
            if len(smart_tokens) >= 3:
                entity = smart_tokens[2]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.exists",
                    "entity": entity,
                    "args": {
                        "entity": entity,
                        "mode": "developer",
                    },
                }

        if clean.startswith("kg.exists "):
            if len(smart_tokens) >= 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.exists",
                    "entity": entity,
                    "args": {
                        "entity": entity,
                        "mode": "developer",
                    },
                }

        # ====================================================
        # ⭐⭐⭐ KG STATS ⭐⭐⭐
        # ====================================================
        if clean in ("kg stats", "kg.stats") or clean.startswith("kg.stats"):
            return {
                "intent": "kg.stats",
                "entity": None,
                "args": {
                    "mode": "developer",
                },
            }

        # ====================================================
        # ⭐⭐⭐ LEVEL 2: POTVRDENÉ UČENIE (KNOWLEDGE EXTRACTOR) ⭐⭐⭐
        # ====================================================
        # Skontrolujeme, či to nie je explicitný systémový príkaz (kg.*, reason.*, atď.)
        is_command = (clean.startswith("kg") or clean.startswith("reason") or 
                      clean.startswith("why") or first_word in OPEN_KEYWORDS)
        
        if not is_command:
            # Hľadáme štruktúru oznamovacej vety cez vzťahové slovesá
            relation_verbs = [" je ", " má ", " ma ", " patrí do ", " patri do ", " obsahuje ", " znamená ", " znamena "]
            
            padded_clean = f" {clean} " # Pridáme medzery, aby sme chytili presné slová
            
            for rel_verb in relation_verbs:
                if rel_verb in padded_clean:
                    parts = padded_clean.split(rel_verb, 1)
                    src = parts[0].strip(" .,:;!?\"'")
                    tgt = parts[1].strip(" .,:;!?\"'")
                    rel = rel_verb.strip()
                    
                    if src and tgt and not self._is_reserved(src) and not self._is_reserved(tgt):
                        return {
                            "intent": "kg.learn_proposal",
                            "entity": src,
                            "args": {
                                "source": src,
                                "relation": rel,
                                "target": tgt,
                                "mode": "learning",
                            },
                            "raw": raw_input,
                            "normalized": clean,
                        }

        # ====================================================
        # ⭐⭐⭐ NATURAL KG RELATE (3-token Fallback) ⭐⭐⭐
        # ====================================================
        if len(tokens) == 3 and not raw_lower.startswith("kg ") and not raw_lower.startswith("kg.") \
           and not raw_lower.startswith("reason ") and not raw_lower.startswith("reason."):
            src = tokens[0]
            rel = tokens[1]
            tgt = tokens[2]

            if self._is_reserved(src) or self._is_reserved(tgt):
                return result

            return {
                "intent": "kg.relate",
                "entity": src,
                "args": {
                    "source": src,
                    "relation": rel,
                    "target": tgt,
                    "mode": "developer",
                },
            }

        # ====================================================
        # ⭐⭐⭐ FALLBACK ⭐⭐⭐
        # ====================================================
        return result
