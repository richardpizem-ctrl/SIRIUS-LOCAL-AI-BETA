                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.view",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
                }

        # ====================================================
        # ⭐⭐⭐ KG PATH ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.path "):
            if len(smart_tokens) >= 3:
                src = smart_tokens[1]
                tgt = smart_tokens[2]
                if self._is_reserved(src) or self._is_reserved(tgt):
