                }

        # ====================================================
        # ⭐⭐⭐ KG RELATIONS ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.relations "):
            if len(smart_tokens) >= 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
                    "intent": "kg.relations",
                    "entity": entity,
                    "args": {"entity": entity, "mode": "developer"},
