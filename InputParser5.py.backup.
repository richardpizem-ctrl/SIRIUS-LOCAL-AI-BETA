import shlex
from runtime5.logging_5 import log5

RESERVED_WORDS = {
    "kg",
    "reason",
    "envoy",
    "system",
    "workflow",
    "runtime",
    "compare",
    "fetch",
    "why",
}

OPEN_KEYWORDS = {
    # Otvorenie
    "otvor",
    "otvoriť",
    "otvorit",
    "otváraj",
    "otvaraj",
    "open",
    # Spustenie
    "spust",
    "spusti",
    "spusť",
    "spustiť",
    "spustit",
    "spúšťaj",
    "spustaj",
    "start",
    "run",
    "launch",
    "execute",
    # Zapnutie
    "zapni",
    "zapnúť",
    "zapnut",
    "zapínaj",
    "zapinaj",
    # Zobrazenie / Ukázanie
    "ukaz",
    "ukáž",
    "zobraz",
    "zobraziť",
    "zobrazit",
    "show",
    # Hovorové / alternatívne tvary
    "nahod",
    "nahoď",
    "odpal",
    "odpál",
}


class InputParser5:
    """
    Input Parser 5.x – stabilná, deterministická, kompatibilná s RuntimeCore 5.x,
    KGReasoner, KG routerom a workflow registry.
    Obsahuje extraktor pre LEVEL 2: Potvrdené učenie.
    Využíva shlex.split pre bezpečné parsovanie entít s medzerami z úvodzoviek.
    """

    def __init__(self):
        log5("[InputParser5] Initialized Input Parser 5.x")

    def _normalize(self, text: str) -> str:
        if not isinstance(text, str):
            return ""
        return text.strip().lower()

    def _tokenize(self, text: str):
        clean = text.strip()
        return clean.split()

    def _smart_split(self, text: str):
        """Rozdelí string, ale rešpektuje úvodzovky (napríklad pre entity z viacerých slov)."""
        try:
            return shlex.split(text)
        except ValueError:
            # Ak sú úvodzovky neuzavreté alebo inak chybné, fallback na obyčajný split
            return text.split()

    def _is_reserved(self, name: str) -> bool:
        if not isinstance(name, str):
            return False
        n = name.strip().lower()
        if not n:
            return False
        if n in RESERVED_WORDS:
            return True
        if n.startswith("kg ") or n.startswith("kg.") \
           or n.startswith("reason ") or n.startswith("reason."):
            return True
        return False

    def parse(self, raw_input: str) -> dict:
        if not isinstance(raw_input, str):
            return {
                "intent": "UNKNOWN",
                "entity": None,
                "args": {},
                "raw": raw_input,
                "normalized": "",
            }

        clean = self._normalize(raw_input)
        tokens = self._tokenize(raw_input)
        smart_tokens = self._smart_split(raw_input)
        raw_lower = raw_input.lower()

        result = {
            "intent": "UNKNOWN",
            "entity": None,
            "args": {},
            "raw": raw_input,
            "normalized": clean,
        }
        
        if not tokens:
            return result
            
        first_word = tokens[0].lower().strip(".,:;!?")

        # ====================================================
        # ⭐⭐⭐ QUESTION_DETECTOR: PREVENT QUESTIONS FROM BECOMING RELATIONS ⭐⭐⭐
        # ====================================================
        is_question = (
            clean.endswith("?") or 
            any(clean.startswith(w) for w in ["čo ", "co ", "kto ", "ako ", "prečo ", "preco ", "kde ", "kedy ", "kolko ", "koľko "])
        )
        if is_question:
            # If it's a question, do not let it fall into natural 3-token relation parsing or default kg.relate.
            # Map it to kg.query so the runtime handles it as a query instead of creating a false relation.
            entity = tokens[-1].strip("?") if tokens else None
            return {
                "intent": "kg.query",
                "entity": entity,
                "args": {
                    "entity": entity,
                    "raw_input": raw_input,
                    "mode": "developer",
                },
                "raw": raw_input,
                "normalized": clean,
            }

        # ====================================================
        # ⭐⭐⭐ FIX: OPEN_APP INTENT (Otvor / Spust / Zapni / Open) ⭐⭐⭐
        # ====================================================
        if first_word in OPEN_KEYWORDS and len(tokens) >= 2:
            target_app = " ".join(tokens[1:]).strip().strip('"').strip("'")
            return {
                "intent": "OPEN_APP",
                "entity": target_app,
                "args": {
                    "app": target_app,
                    "target": target_app,
                    "action": "open",
                },
                "raw": raw_input,
                "normalized": clean,
            }

        # ====================================================
        # ⭐⭐⭐ KG RELATE (OPRAVENÉ - POUŽÍVA SMART SPLIT) ⭐⭐⭐
        # ====================================================
        if raw_lower.startswith("kg.relate "):
            if len(smart_tokens) == 4:
                src = smart_tokens[1]
                rel = smart_tokens[2]
                tgt = smart_tokens[3]
                if self._is_reserved(src) or self._is_reserved(tgt):
                    return result
                return {
                    "intent": "kg.relate",
                    "entity": src,
                    "args": {
                        "source": src,
                        "relation": rel,
                        "target": tgt,
                        "mode": "developer",
                    },
                }

        if raw_lower.startswith("kg relate "):
            if len(smart_tokens) == 5:
                src = smart_tokens[2]
                a = smart_tokens[3]
                b = smart_tokens[4]

                RELATION_WORDS = {
                    "je", "ma", "má", "ma_vlastnost", "patri_do", "patrí_do",
                    "obsahuje", "je_typ", "je_cast", "je_podtyp",
                    "je_instance", "je_kategoria", "je_kategória"
                }

                if a.lower() in RELATION_WORDS:
                    rel = a
                    tgt = b
                elif b.lower() in RELATION_WORDS:
                    rel = b
                    tgt = a
                else:
                    rel = a
                    tgt = b

                if self._is_reserved(src) or self._is_reserved(tgt):
                    return result

                return {
                    "intent": "kg.relate",
                    "entity": src,
                    "args": {
                        "source": src,
                        "relation": rel,
                        "target": tgt,
                        "mode": "developer",
                    },
                }

        # ====================================================
        # ⭐⭐⭐ KG REMOVE_RELATION ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.remove_relation "):
            if len(smart_tokens) >= 4:
                src = smart_tokens[1]
                rel = smart_tokens[2]
                tgt = smart_tokens[3]
                if self._is_reserved(src) or self._is_reserved(tgt):
                    return result
                return {
                    "intent": "kg.remove_relation",
                    "entity": src,
                    "args": {
                        "source": src,
                        "relation": rel,
                        "target": tgt,
                        "mode": "developer",
                    },
                }

        if clean.startswith("kg remove_relation "):
            if len(smart_tokens) >= 5:
                src = smart_tokens[2]
                rel = smart_tokens[3]
                tgt = smart_tokens[4]
                if self._is_reserved(src) or self._is_reserved(tgt):
                    return result
                return {
                    "intent": "kg.remove_relation",
                    "entity": src,
                    "args": {
                        "source": src,
                        "relation": rel,
                        "target": tgt,
                        "mode": "developer",
