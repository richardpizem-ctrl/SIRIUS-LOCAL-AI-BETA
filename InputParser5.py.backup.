                return {
                    "intent": "reason.orbits",
                    "entity": entity,
                    "args": {
                        "entity": entity,
                        "mode": "developer",
                    },
                }

        # ====================================================
        # ⭐⭐⭐ REASON INFER ⭐⭐⭐
        # ====================================================
        if clean.startswith("reason.infer") or clean.startswith("reason infer"):
            return {
                "intent": "reason.infer",
                "entity": None,
                "args": {"mode": "developer"},
            }

        # ====================================================
        # ⭐⭐⭐ KG VIEW ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.view "):
            if len(smart_tokens) >= 2:
                entity = smart_tokens[1]
                if self._is_reserved(entity):
                    return result
                return {
