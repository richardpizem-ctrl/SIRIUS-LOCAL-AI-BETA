                    "entity": entity,
                    "args": {
                        "entity": entity,
                        "mode": "developer",
                    },
                }

        # ====================================================
        # ⭐⭐⭐ KG MERGE ⭐⭐⭐
        # ====================================================
        if clean.startswith("kg.merge "):
            if len(smart_tokens) == 3:
                source = smart_tokens[1]
                target = smart_tokens[2]
                if self._is_reserved(source) or self._is_reserved(target):
